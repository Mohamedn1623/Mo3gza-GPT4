```env
# ==========================================
# EMAIL
# ==========================================

# All website notifications will be sent here
EMAIL_TO=mohamedn1623@gmail.com

# Sender email.
# For Gmail, normally use the same email as SMTP_USER.
EMAIL_FROM=

# ==========================================
# SMTP
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# APPLICATION
# ==========================================

# Local development URL
APP_URL=http://localhost:5173

# Backend server port
SERVER_PORT=4000

# Leave empty when the frontend and API are deployed on the same domain.
# For a separate API host, set the full origin (for example https://api.example.com).
VITE_API_URL=

# ==========================================
# ADMIN DASHBOARD
# ==========================================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# ==========================================
# PERSISTENT STORAGE (recommended for Vercel)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=server-only-secret-key
# Legacy projects can use SUPABASE_SERVICE_ROLE_KEY instead.

# ==========================================
# OPTIONAL SMS (Twilio)
# Set TWILIO_FROM_NUMBER or TWILIO_MESSAGING_SERVICE_SID.
# ==========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
```
