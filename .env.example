```env
# ==========================================
# EMAIL
# ==========================================

# All website notifications will be sent here
EMAIL_TO=mohamedn1623@gmail.com

# Sender email.
# For Gmail, normally use the same email as SMTP_USER.
EMAIL_FROM=

# ==========================================
# SMTP
# ==========================================

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# APPLICATION
# ==========================================

# Local development URL
APP_URL=http://localhost:5173

# Backend server port
SERVER_PORT=4000

# Leave empty for local dev; set to /api in Vercel
VITE_API_URL=
```
